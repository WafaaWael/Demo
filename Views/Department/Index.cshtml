<!--strong type-->
@model List<Department>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
 <table class="table  table-bordered table-hover">
    <tr>
    <th> ID  </th>
    <th>Manager Name</th>
    <th>	Name  </th>
</tr>

	@foreach (var item in Model)
    {
        <tr>
            <td>@item.ID</td>
            <td>@item.ManagerName</td>
            <td>@item.Name</td>

        </tr>
    }
 </table>
